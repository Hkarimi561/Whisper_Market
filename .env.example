# Copy to .env to change defaults. docker compose works without it.
POSTGRES_USER=whisper
POSTGRES_PASSWORD=whisper
POSTGRES_DB=whisper_market
APP_PORT=3000

# For running outside Docker (npm run dev) against a local Postgres. Leave unset to play without persistence.
# DATABASE_URL=postgresql://whisper:whisper@localhost:5432/whisper_market?schema=public
PORT=3000

# Optional "Sign in with Google". Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# and add your site origin (e.g. http://localhost:3000) under "Authorized JavaScript origins". Leave empty to hide the button.
GOOGLE_CLIENT_ID=
